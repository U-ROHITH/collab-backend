# Copy to backend/.env (gitignored) and fill with LOCAL/TEST values only.
# Production secrets live in Render's environment settings, never in files or chat.

# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=ops-change-me/   # non-default admin path
LOG_LEVEL=INFO

# Allowed browser origins (React apps), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Postgres
# Web: Supabase transaction pooler (port 6543). Migrations: direct/session connection (port 5432).
DATABASE_URL=postgres://app:app@localhost:5432/collab
DATABASE_MIGRATION_URL=postgres://app:app@localhost:5432/collab

# Redis (cache, throttles, Celery broker, Channels layer)
REDIS_URL=redis://localhost:6379/0

# Supabase Auth + Storage. SERVICE_ROLE_KEY is server-only; never put it in a React app.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BUCKET=public-media
STORAGE_PRIVATE_BUCKET=private

# Razorpay: TEST keys outside production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Social OAuth
META_APP_ID=
META_APP_SECRET=
# Comma-separated OAuth client IDs whose ID tokens we accept (defaults to the web client in settings)
GOOGLE_OAUTH_CLIENT_IDS=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000/v1

# 32-byte base64 key for AES-GCM (social tokens / PAN): openssl rand -base64 32
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_VERSION=1

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# Web push: python -m py_vapid --gen  (or npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Observability
SENTRY_DSN=

# Feature flags / kill switches
PAYOUTS_FROZEN=false
MESSAGING_ENABLED=true
SOCIAL_SYNC_ENABLED=false
